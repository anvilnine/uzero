{
  "name": "uzero",
  "description": "Choose your default Google account and the order of your signed-in Google accounts.",
  "private": true,
  "version": "0.1.3",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/anvilnine/uzero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvilnine/uzero.git"
  },
  "bugs": "https://github.com/anvilnine/uzero/issues",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:preview": "wxt build --mode preview",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "zip:edge": "wxt zip -b edge",
    "release": "scripts/release.sh"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.9",
    "@wxt-dev/module-svelte": "^2.0.4",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.1.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
